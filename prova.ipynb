    "import matplotlib.pyplot as plt\n",
    "from matplotlib.textpath import TextPath\n",
    "from matplotlib.patches import PathPatch\n",
    "from matplotlib.transforms import Affine2D\n",
    "import numpy as np\n",
    "\n",
    "def draw_curved_text(text, radius=5, center=(0, 0), font_size=1.0, direction='cw'):\n",
    "    fig, ax = plt.subplots()\n",
    "    ax.set_aspect('equal')\n",
    "    ax.axis('off')\n",
    "\n",
    "    # Adjust direction of curve\n",
    "    if direction not in ['cw', 'ccw']:\n",
    "        raise ValueError(\"Direction must be 'cw' (clockwise) or 'ccw' (counter-clockwise)\")\n",
    "    sign = -1 if direction == 'cw' else 1\n",
    "\n",
    "    # Total text width to calculate angle per unit length\n",
    "    text_paths = [TextPath((0, 0), char, size=font_size) for char in text]\n",
    "    char_widths = [path.get_extents().width for path in text_paths]\n",
    "    total_width = sum(char_widths)\n",
    "\n",
    "    # Circumference & angle per unit of text width\n",
    "    circumference = 2 * np.pi * radius\n",
    "    angle_per_unit = 2 * np.pi / circumference\n",
    "\n",
    "    current_angle = 0\n",
    "\n",
    "    for char, path, width in zip(text, text_paths, char_widths):\n",
    "        # Angle for this character (centered)\n",
    "        char_angle = current_angle + sign * angle_per_unit * width / 2\n",
    "\n",
    "        # Position of character along circle\n",
    "        x = center[0] + radius * np.cos(char_angle)\n",
    "        y = center[1] + radius * np.sin(char_angle)\n",
    "\n",
    "        # Rotation: tangent to the circle\n",
    "        rotation = np.rad2deg(char_angle + sign * np.pi / 2)\n",
    "\n",
    "        # Transformation: rotate and translate\n",
    "        trans = (Affine2D()\n",
    "                 .rotate_deg_around(0, 0, rotation)\n",
    "                 .translate(x, y))\n",
    "        \n",
    "        patch = PathPatch(path, transform=trans + ax.transData, color='black', lw=0.5)\n",
    "        ax.add_patch(patch)\n",
    "\n",
    "        # Advance angle for next character\n",
    "        current_angle += sign * angle_per_unit * width\n",
    "\n",
    "    ax.set_xlim(-radius - 2, radius + 2)\n",
    "    ax.set_ylim(-radius - 2, radius + 2)\n",
    "    plt.show()\n",
    "\n",
    "# Example usage\n",
    "draw_curved_text(\"Hello, Circle!\", radius=5, font_size=1.0, direction='cw')\n"
