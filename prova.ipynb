    "symbols = ['\\u2648', '\\u2649', '\\u264A', '\\u264B', '\\u264C', '\\u264D','\\u264E', '\\u264F', '\\u2650', '\\u2651', '\\u2652', '\\u2653']\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "x = np.linspace(0,2*np.pi, 361)\n",
    "y = np.sin(x) \n",
    "ax.plot(x,y, 'r:')\n",
    "for i, symbol in enumerate(symbols):\n",
    "    angle = np.rad2deg(np.atan2((y[30*i+1]-y[30*i]), (x[30*i+1]-x[30*i])))\n",
    "    t = Affine2D().rotate_deg(angle)\n",
    "    ax.plot((x[30*i]), (y[30*i]), marker=MarkerStyle('>', transform=t), markersize=11, color='red', markeredgewidth=0)\n",
    "    angle = np.rad2deg(np.atan2((y[30*i+16]-y[30*i+15]), (x[30*i+16]-x[30*i+15])))\n",
    "    ax.text(x[30*i+15],(y[30*i+15]), symbol, color='r', ha='center', va='bottom', rotation=angle, rotation_mode='anchor')  # rotates around anchor point)\n",
    "ax.set_ylim((-5,1.5))"
   ]
