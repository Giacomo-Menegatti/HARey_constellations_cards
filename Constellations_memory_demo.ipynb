    "# Create scoring function to assign scores between 0 and 1\n",
    "\n",
    "def score(x):\n",
    "    return (x- min(x))/(max(x)-min(x))\n",
    "\n",
    "size_score = score(constellation_df['n_stars'])\n",
    "# Remap the size score to penalize constellations which are too big or too small\n",
    "size_score = 4*size_score*(1-size_score)\n",
    "\n",
    "# Mean brightness score, as similar stars are easier to find\n",
    "importance_score = 1-score(constellation_df['mean brightness'])\n",
    "# Brightest star score\n",
    "brightness_score = 1-score(constellation_df['brightest star'])\n",
    "\n",
    "# Combine the three scores (I chose to give less importance to the size score)\n",
    "constellation_df['score'] = importance_score + brightness_score + 0.8*size_score\n",
    "\n",
    "# Keep only the constellations that are visible \n",
    "constellation_df = constellation_df[~constellation_df['Visibility'].isin(['never visible', 'hardly visible'])]\n",
    "# Order the constellation by their score\n",
    "constellation_df.sort_values(by = 'score', ascending=False, ignore_index=False).head(40)"
   ]
  }
