   "source": [
    "df = harey.stars.loc[harey.stars['constellation'] != 'none', ['constellation', 'magnitude', 'ra', 'dec']]\n",
    "df['name'] = df['constellation'].map(harey.names)\n",
    "df['name'] = df['name'].str.replace('\\n', ' ')\n",
    "\n",
    "print(df.head())\n",
    "\n",
    "grouped = df.groupby(['constellation'])\n",
    "brightest = grouped['magnitude'].min().rename('brightest star')\n",
    "mean_luminosity = grouped['magnitude'].mean().rename('mean brightness')\n",
    "n_stars = grouped.size().rename('n_stars')\n",
    "name = grouped['name'].first().rename('name')\n",
    "\n",
    "visibility = grouped.apply(lambda g : pd.Series(harey.is_visible('45 N', g['ra'], g['dec'], LVZ = 5), index=['Visibility', 'Best Period']), include_groups=False)\n",
    "\n",
    "constellation_df = pd.concat([name, brightest, mean_luminosity, n_stars, visibility], axis=1)\n",
    "constellation_df.head(10)"
   ]
